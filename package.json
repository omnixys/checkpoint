{
  "name": "checkpoint",
  "version": "0.1.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "codegen": "graphql-codegen",
    "seed": "pnpm --dir ../../seed seed",
    "test": "vitest run",
    "test:unit": "vitest run src/errors src/lib/apollo src/hooks/internal src/hooks/support src/components/notification",
    "test:components": "vitest run src/components/error src/hooks/error",
    "test:types": "tsc --noEmit",
    "release": "semantic-release",
    "registry:setup": "node scripts/setup-npmrc.js",
    "registry:cleanup": "node scripts/setup-npmrc.js --remove",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:debug": "playwright test --debug"
  },
  "packageManager": "pnpm@10.33.0",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "files": [
    "src/**/*",
    "messages/**/*.json"
  ],
  "private": false,
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "dependencies": {
