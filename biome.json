{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",

  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },

  "files": {
    "ignoreUnknown": true,

    "includes": [
      "src/**/*",
      "app/**/*",
      "components/**/*",
      "lib/**/*",
      "hooks/**/*",
      "types/**/*",

      "!node_modules",
      "!.next",
      "!dist",
      "!build",
      "!coverage",
      "!src/generated"
    ]
  },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      "suspicious": {
        "noConsole": "off",
        "noDocumentCookie": "off",
        "noExplicitAny": "off",
        "noEmptyBlockStatements": "off"
      },

      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedFunctionParameters": "error",
        "useHookAtTopLevel": "error",
        "useExhaustiveDependencies": "error"
      },

      "style": {
        "noDefaultExport": "off",
        "noJsxLiterals": "off",
        "noMagicNumbers": "off",
        "useNamingConvention": "off",
        "noNestedTernary": "off",
        "useExportsLast": "off",
        "useFilenamingConvention": "off",
        "noNonNullAssertion": "off",
        "noProcessEnv": "off",
        "noEnum": "off",
        "noSubstr": "off"
      },

      "complexity": {
        "noBannedTypes": "off",
        "noStaticOnlyClass": "off"
      },

      "performance": {
        "noImgElement": "off"
      },

      "a11y": {
        "noSvgWithoutTitle": "off",
        "useButtonType": "off",
        "useAltText": "off"
      }
    },

    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },

  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
